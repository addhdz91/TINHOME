{
  "name": "tinhome",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n functions,emulators,web -c yellow,cyan,blue \"pnpm --filter @tinhome/functions build:watch\" \"pnpm emulators\" \"pnpm --filter @tinhome/web dev\"",
    "emulators": "pnpm --filter @tinhome/functions build && pnpm exec firebase emulators:start --project demo-tinhome",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter !@tinhome/rules-tests test",
    "test:rules": "pnpm exec firebase emulators:exec --only firestore,storage --project demo-tinhome \"pnpm --filter @tinhome/rules-tests test\"",
    "test:e2e": "echo \"E2E (Playwright) llega con el primer flujo crítico (M1)\"",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "seed": "tsx scripts/seed.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tinhome/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
