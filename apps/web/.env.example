# Copia a .env.local. Nunca pongas secretos aquí (todo lo VITE_ llega al navegador).
VITE_USE_EMULATORS=true
VITE_PUBLIC_URL=http://localhost:5173

# Proyecto Firebase (en emuladores bastan los valores demo)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tinhome.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tinhome
VITE_FIREBASE_STORAGE_BUCKET=demo-tinhome.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# App Check (reCAPTCHA Enterprise). Vacío en local.
VITE_APPCHECK_SITE_KEY=

# Sentry (región UE). Vacío = desactivado.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
